# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase dashboard → Project Settings → API Keys.
# The publishable key is safe in the browser: it can only do what the
# database's Row Level Security rules allow. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The owner's WhatsApp number that orders get sent to.
# International format, digits only, no + (e.g. 233241234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=233000000000
